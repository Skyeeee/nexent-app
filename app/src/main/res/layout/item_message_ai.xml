<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="56dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- AI avatar -->
    <FrameLayout
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_avatar_08">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_avatar_placeholder" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Thinking process (step-by-step reasoning) with collapse/expand -->
        <LinearLayout
            android:id="@+id/thinking_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_search_bar"
            android:padding="8dp">

            <!-- Toggle header -->
            <LinearLayout
                android:id="@+id/thinking_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:paddingStart="4dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/tv_toggle_arrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▼"
                    android:textSize="10sp"
                    android:textColor="@color/text_tertiary"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tv_thinking_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/thinking_label"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_thinking_dots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="..."
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp"
                    android:visibility="gone"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- Thinking content with fixed max height and internal scrolling -->
            <ScrollView
                android:id="@+id/thinking_scroll_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxHeight="220dp"
                android:layout_marginTop="4dp"
                android:scrollbars="vertical">

                <TextView
                    android:id="@+id/tv_thinking"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="260dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />
            </ScrollView>
        </LinearLayout>

        <!-- Main message content (Markdown rendered) -->
        <LinearLayout
            android:id="@+id/message_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_bubble_ai"
                android:minWidth="180dp"
                android:maxWidth="320dp"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />

        </LinearLayout>

        <!-- Search results citation button -->
        <LinearLayout
            android:id="@+id/search_results_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            android:layout_marginStart="4dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <TextView
                android:id="@+id/tv_search_results"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textSize="11sp"
                android:background="@drawable/bg_search_bar" />

            <TextView
                android:id="@+id/tv_search_results_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:padding="8dp"
                android:layout_marginTop="4dp"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:background="@drawable/bg_search_bar"
                android:maxWidth="260dp" />
        </LinearLayout>

        <!-- Web images from picture_web -->
        <LinearLayout
            android:id="@+id/images_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            android:layout_marginStart="4dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <TextView
                android:id="@+id/tv_images_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <ImageView
                android:id="@+id/iv_image_preview"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:scaleType="centerCrop"
                android:layout_marginTop="4dp" />

            <!-- Expanded images grid (placeholder for more images) -->
            <LinearLayout
                android:id="@+id/images_grid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tv_images_more"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/text_tertiary"
                    android:visibility="gone"
                    android:padding="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Token metrics footnote -->
        <TextView
            android:id="@+id/tv_token_metrics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:textSize="10sp"
            android:textColor="@color/text_tertiary" />

        <!-- Streaming indicator -->
        <TextView
            android:id="@+id/tv_streaming_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:text="@string/ai_thinking"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>